odel = RandomForestClassifier(random_state=42)\n","knn_model = KNeighborsClassifier(n_neighbors=5)\n","svm_model = SVC(kernel='rbf', C=1)\n","\n","# 5. 모델 학습\n","log_model.fit(X_train_scaled, y_train)\n","rf_model.fit(X_train, y_train)                      # 의사결정트리는 스케일링 필요 없음\n","knn_model.fit(X_train_scaled, y_train)\n","svm_model.fit(X_train_scaled, y_train)\n","\n","# 6. 예측\n","log_pred = log_model.predict(X_test_scaled)\n","rf_pred = rf_model.predict(X_test)\n","knn_pred = knn_model.predict(X_test_scaled)\n","svm_pred = svm_model.predict(X_test_scaled)\n","\n","# 7. 정확도 출력\n","print(\"로지스틱 회귀 정확도:\", accuracy_score(y_test, log_pred))\n","print(\"랜덤포레스트 정확도:\", accuracy_score(y_test, rf_pred))\n","print(\"KNN 정확도:\", accuracy_score(y_test, knn_pred))\n","print(\"SVM 정확도:\", accuracy_score(y_test, svm_pred))"],"metadata":{"id":"D-W-M6b3HjXV","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1779692753694,"user_tz":-420,"elapsed":3488,"user":{"displayName":"11505고대우","userId":"00091654125507717601"}},"outputId":"2549c3c8-f236-40a0-9a3b-73339eead4a9"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["로지스틱 회귀 정확도: 0.782608695652174\n","랜덤포레스트 정확도: 0.8115942028985508\n","KNN 정확도: 0.7463768115942029\n","SVM 정확도: 0.7608695652173914\n"]}]},{"cell_type":"markdown","source":["#### **>> 모델 정확도를 높여볼까? 파생 변수 만들기!!**\n","\n","\n","\n","> 특성 공학(Feature Engineering)이란? 기존 데이터를 가공해서 모델이 더 잘 학습할 수 있도록 만드는 과정\n","\n"],"metadata":{"id":"RgcjAMcxG7lQ"}},{"cell_type":"code","source":["df_new1=df_new.copy()\n","\n","# df_new1['증상점수'] = df_new1[['당뇨병 가계도 기능','혈압','포도당','인슐린','피부두께']].sum(axis=1)\n","# df_new1['생활위험'] = df_new1['임신'] + df_new1['나이'] + df_new1['또래영향']\n","# df_new1['흡연기침'] = df_new1['임신'] * df_new1['기침']\n","# df_new1['호흡문제'] = df_new1['호흡곤란'] + df_new1['쌕쌕거림여부']\n","# df_new1['건강취약'] = df_new1['만성질환'] + df_new1['피로']\n","# df_new1['고령'] = (df_new1['나이'] >= 60).astype(int)\n","\n","df_new1['비만위험'] = (